# cp .env.example .env

# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls)
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Optional: use an OpenAI-compatible provider (e.g. OpenRouter).
# Comment out both lines below to use api.openai.com directly.
# NOTE: on OpenRouter the model MUST be prefixed with the provider slug.
# ---------------------------------------------------------------------------
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini
